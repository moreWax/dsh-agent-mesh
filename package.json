{
  "name": "@morewax/dsh-agent-mesh",
  "version": "0.1.0",
  "description": "SAM-native capability mesh for DeepSeek Harness: tools, inference, tasks, node operations, and policy-aware routing",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core/index.js",
    "./tools": "./lib/tools/index.js",
    "./inference": "./lib/inference/index.js",
    "./tasks": "./lib/tasks/index.js",
    "./operator": "./lib/operator/index.js",
    "./llm": "./lib/llm/index.js",
    "./providers": "./lib/providers/index.js",
    "./providers/tools": "./lib/providers/tools-plugin.js",
    "./tasks/service": "./lib/tasks/plugin.js",
    "./tasks/sqlite": "./lib/tasks/sqlite.js",
    "./tasks/dsh-executor": "./lib/tasks/dsh-executor.js",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "acceptance"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sam",
    "sovereign-agent-mesh",
    "mcp",
    "libp2p"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreWax/dsh-agent-mesh.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/client/index.tsx src/remote.ts src/typert.host.ts src/cli/index.ts src/core/index.ts src/tools/index.ts src/inference/index.ts src/tasks/index.ts src/tasks/plugin.ts src/tasks/sqlite.ts src/tasks/dsh-executor.ts src/operator/index.ts src/providers/index.ts src/providers/tools-plugin.ts src/llm/index.ts --format esm --dts --out-dir lib && chmod +x lib/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "acceptance": "bash acceptance/run.sh local",
    "acceptance:two-node": "bash acceptance/run.sh two-node",
    "acceptance:k8s": "bash acceptance/run.sh k8s",
    "smoke:tasks": "bash acceptance/task-service-smoke.sh",
    "pack:check": "pnpm build && npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.0.1-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.0.1-rc.1",
    "@deepseek-ai/dsh-brand": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.0.1-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.0.1-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18",
    "react": "^18",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  },
  "bin": {
    "dsh-agent-mesh": "./lib/cli/index.js"
  }
}
