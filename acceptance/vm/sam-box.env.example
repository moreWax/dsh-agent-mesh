# Paths are deliberately explicit. Copy to /etc/sam/acceptance.env and adjust.
SAM_NODE=/usr/local/bin/sam-node
SAM_BOX=/usr/local/bin/sam-box
NANO_INIT=/usr/local/bin/nano-init
NODE_CONFIG=/etc/sam/node.yaml
CONTROL_PLANE=https://control-plane.example.invalid
JWT_PATH=/run/credentials/sam.jwt
NODE_SOCKET=/run/sam/node.sock
AGENT_SOCKET=/run/sam/agent.sock
AGENT_COMMAND=/opt/agent/bin/agent
