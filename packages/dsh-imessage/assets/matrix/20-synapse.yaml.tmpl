apiVersion: v1
kind: PersistentVolumeClaim
metadata: { name: synapse-data, namespace: {{NAMESPACE}} }
spec: { accessModes: [ReadWriteOnce], resources: { requests: { storage: 8Gi } } }
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: synapse, namespace: {{NAMESPACE}} }
spec:
  replicas: 1
  selector: { matchLabels: { app.kubernetes.io/name: synapse, app.kubernetes.io/part-of: dsh-imessage } }
  template:
    metadata: { labels: { app.kubernetes.io/name: synapse, app.kubernetes.io/part-of: dsh-imessage } }
    spec:
      securityContext: { fsGroup: 991, runAsNonRoot: true }
      containers:
      - name: synapse
        image: matrixdotorg/synapse@sha256:10349cb92143a6289ad4e078671a8ba52ff2d1565d2dc252f3c6aea2bbb7faf7
        imagePullPolicy: IfNotPresent
        env: [{ name: SYNAPSE_CONFIG_PATH, value: /data/homeserver.yaml }]
        ports: [{ name: client, containerPort: 8008 }]
        readinessProbe: { httpGet: { path: /health, port: client }, periodSeconds: 10, timeoutSeconds: 5 }
        resources: { requests: { cpu: 200m, memory: 512Mi }, limits: { memory: 2Gi } }
        volumeMounts:
        - { name: data, mountPath: /data }
        - { name: config, mountPath: /data/homeserver.yaml, subPath: homeserver.yaml, readOnly: true }
        - { name: config, mountPath: /data/signing.key, subPath: signing.key, readOnly: true }
      volumes:
      - { name: data, persistentVolumeClaim: { claimName: synapse-data } }
      - { name: config, secret: { secretName: dsh-imessage-synapse-config } }
---
apiVersion: v1
kind: Service
metadata: { name: synapse, namespace: {{NAMESPACE}} }
spec: { selector: { app.kubernetes.io/name: synapse }, ports: [{ name: client, port: 8008, targetPort: client }] }
