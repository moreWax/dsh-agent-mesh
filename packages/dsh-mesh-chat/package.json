{
  "name": "@morewax/dsh-mesh-chat",
  "version": "0.1.0",
  "description": "Authenticated chat over the SAM mesh \u2014 fleet channel with system events, peer DMs, capability-gated. Separate plugin: consumes the agentMesh service, never imports dsh-agent-mesh.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json",
    "./store": "./lib/store.js",
    "./inbox": "./lib/inbox.js",
    "./fleet-channel": "./lib/fleet-channel.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/check-client-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@morewax/sam-mesh": "workspace:*",
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18",
    "react": "^18",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
