{
  "name": "@morewax/dsh-agent-mesh",
  "version": "0.1.0",
  "description": "SAM-native capability mesh plugin for DeepSeek Harness \u2014 consume mesh tools/models/tasks, publish dsh capabilities, manage the node from the Web UI",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/tools/index.js",
    "./inference": "./lib/inference/index.js",
    "./tasks": "./lib/tasks/index.js",
    "./operator": "./lib/operator/index.js",
    "./llm": "./lib/llm/index.js",
    "./providers": "./lib/providers/index.js",
    "./providers/tools": "./lib/providers/tools-plugin.js",
    "./tasks/service": "./lib/tasks/plugin.js",
    "./tasks/sqlite": "./lib/tasks/sqlite.js",
    "./tasks/dsh-executor": "./lib/tasks/dsh-executor.js",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-agent-mesh": "./lib/cli/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && node scripts/check-client-bundle.mjs && chmod +x lib/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "acceptance": "bash acceptance/run.sh local",
    "acceptance:two-node": "bash acceptance/run.sh two-node",
    "acceptance:k8s": "bash acceptance/run.sh k8s",
    "smoke:tasks": "bash acceptance/task-service-smoke.sh"
  },
  "dependencies": {
    "@morewax/sam-mesh": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.0.1-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.0.1-rc.1",
    "@deepseek-ai/dsh-brand": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.0.1-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.0.1-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18",
    "react": "^18",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "github:moreWax/dsh-agent-mesh",
    "directory": "packages/dsh-agent-mesh"
  }
}
